# --- LLM enrichment configuration (optional) ---
# Agent 1 works fully with pure rules even without keys.
# Set these to enable semantic enrichment.

# Groq (fast, free): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free, fallback): https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Primary model for Groq
LLM_PRIMARY_MODEL=openai/gpt-oss-120b

# Fallback model for Gemini
LLM_FALLBACK_MODEL=gemini-3.6-flash

# Enable LLM enrichment (true/false)
LLM_ENABLED=true

# --- Rule engine overrides ---
# Default inventory dimension score when no inventory data is provided (0-100)
INVENTORY_SCORE_BASE=30